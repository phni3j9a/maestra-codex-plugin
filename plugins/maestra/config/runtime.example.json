{
  "schema_version": 1,
  "artifact_dir": "maestra",
  "models": {
    "main": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    },
    "orchestrator": {
      "model": "gpt-5.6-terra",
      "reasoning_effort": "xhigh"
    },
    "implementer": {
      "model": "gpt-5.6-luna",
      "reasoning_effort": "max"
    },
    "reviewer": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "xhigh"
    },
    "final_reviewer": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "xhigh"
    }
  },
  "planning": {
    "owner": "main",
    "detailed_plan_required": true,
    "terra_may_infer_missing_design": false
  },
  "review": {
    "max_rounds": 2,
    "max_major_findings": 5,
    "minor_findings_block": false,
    "finding_freeze": true
  },
  "execution": {
    "sequential_tasks": true,
    "one_task_one_commit": true,
    "terra_owns_commits": true,
    "main_reads_task_transcripts": false,
    "require_clean_worktree_at_run_start": true
  }
